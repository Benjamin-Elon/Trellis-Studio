{
  "appId": "com.benjaminelon.trellisfordrawio",
  "executableName": "Trellis Studio",
  "copyright": "Copyright 2026 Benjamin Elon",
  "asar": true,
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}",
    "!vendor{,/**}",
    "!android-companion{,/**}",
    "!.test-artifacts{,/**}"
  ],
  "directories": {
    "output": "./dist/"
  },
  "npmRebuild": true,
  "publish": {
      "provider": "github"
  },
  "win": {
    "target": [
      {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-ia32-${version}-windows-32bit-installer.${ext}",
  	"oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": true,
    "createDesktopShortcut": false
  },
  "afterPack": "build/fuses.cjs",
  "fileAssociations": [
	  {
	  	"ext": "drawio",
      "name": "Trellis OS Diagram",
      "description": "Trellis OS Diagram",
	  	"mimeType": "application/vnd.jgraph.mxfile",
      "icon": "icon.ico",
	  	"role": "Editor"
	  },
	  {
	  	"ext": "vsdx",
	  	"name": "VSDX Document",
	  	"description": "VSDX Document",
	  	"mimeType": "application/vnd.visio",
	  	"role": "Editor"
	  }
  ]
}
