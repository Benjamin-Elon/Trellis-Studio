{
  "appId": "com.benjaminelon.trellisfordrawio",
  "executableName": "Trellis Studio",
  "copyright": "Copyright 2026 Benjamin Elon",
  "asar": true,
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}",
    "!vendor{,/**}",
    "!android-companion{,/**}",
    "!.test-artifacts{,/**}"
  ],
  "artifactName": "${productName}-${arch}-${version}.${ext}",
  "directories": {
    "output": "./dist/"
  },
  "npmRebuild": true,
  "publish": {
      "provider": "github"
  },
  "win": {
    "target": [
      {
          "target": "appx",
          "arch": [
            "x64"
          ]
      }
    ]
  },
  "appx": {
    "displayName": "Trellis OS",
    "publisherDisplayName": "draw.io Ltd",
    "identityName": "draw.io.draw.ioDiagrams",
    "publisher": "CN=9E628CCB-BE04-4557-A5A8-81EC34B09733"
  },
  "afterPack": "build/fuses.cjs",
  "fileAssociations": [
	  {
	  	"ext": "drawio",
      "name": "Trellis OS Diagram",
      "description": "Trellis OS Diagram",
	  	"mimeType": "application/vnd.jgraph.mxfile",
	  	"role": "Editor"
	  },
	  {
	  	"ext": "vsdx",
	  	"name": "VSDX Document",
	  	"description": "VSDX Document",
	  	"mimeType": "application/vnd.visio",
	  	"role": "Editor"
	  }
  ]
}
